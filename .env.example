# bkk-stock 설정. 이 파일은 git에 올리지 않는다 (.gitignore). 권한은 600.
# 값을 채운 뒤 대시보드의 API 관리 화면에서 '연결 테스트'로 확인한다.

# 한국투자증권 (조회 전용, 실전 앱키)
KIS_APP_KEY=
KIS_APP_SECRET=
KIS_ACCOUNT=
KIS_ACCOUNT_PROD=01

# KRX Open API (서비스별 활용신청 승인 필요)
KRX_OPENAPI_KEY=

# OpenDART
DART_API_KEY=

# 공공데이터포털 금융위원회_주식시세정보 (선택, Decoding 키)
DATA_GO_KR_KEY=

# 네이버 검색 API (선택. 없으면 구글 뉴스 RSS)
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=

# 텔레그램 (코인 봇과 다른 주식 전용 봇)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# 대시보드 (install.sh가 자동으로 만든다)
DASH_PASSWORD=
DASH_SECRET=

# 서버 밖 백업 명령 (선택). {dir}는 백업 폴더로 바뀐다. 예: rclone copy {dir} r2c:bkk-hub-backup
# (sync가 아니라 copy — 로컬은 14일 뒤 지우므로 sync면 원격도 지워진다. 보유 수량이 들어 있으니 암호화 원격(crypt) 권장)
BACKUP_CMD=

# 서버 밖 '죽음 감지' (선택, 권장). healthchecks.io 무료 가입 → 설정의 Ping key 로 만든 주소.
# 예: https://hc-ping.com/<ping-key>  → 작업마다 /bkk-daily, /bkk-morning … 체크가 자동으로 생기고,
# 정해진 시간에 핑이 안 오면 메일로 알려 준다 (텔레그램이 없어도, 서버가 통째로 죽어도).
HC_PING_URL=

# 투자자별 매매 수집 범위: all(전 종목, 약 4분) 또는 watchlist(관심 종목만)
INVESTOR_SCOPE=all
# 한국투자증권 초당 호출 수 (1~18)
KIS_RATE_PER_SEC=12
